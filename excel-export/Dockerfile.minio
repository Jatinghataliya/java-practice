FROM alpine:3.19

RUN apk add --no-cache curl libc6-compat bash ca-certificates && \
    curl -fsSL -L "https://github.com/minio/minio/releases/download/RELEASE.2024-05-10T01-41-38Z/minio.linux-amd64.RELEASE.2024-05-10T01-41-38Z" -o /usr/local/bin/minio && \
    chmod +x /usr/local/bin/minio

EXPOSE 9000 9001

ENV MINIO_ROOT_USER=minioadmin \
    MINIO_ROOT_PASSWORD=minioadmin

VOLUME ["/data"]

CMD ["minio", "server", "/data", "--console-address", ":9001"]
